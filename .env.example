# Copy this file to .env and fill in your own credentials:
#   cp .env.example .env
#
# Choose one OpenAI-compatible text LLM provider.

# Tencent TokenHub HY3
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://tokenhub.tencentmaas.com/v1
LLM_MODEL_NAME=hy3

# DeepSeek V4 Flash (alternative)
# LLM_API_KEY=your-deepseek-api-key
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL_NAME=deepseek-v4-flash

# Optional cloud ASR. Without these credentials (or if the cloud request fails),
# AuK lazily downloads and uses SenseVoiceSmall on CPU.
TENCENTCLOUD_SECRET_ID=your-tencentcloud-secret-id
TENCENTCLOUD_SECRET_KEY=your-tencentcloud-secret-key
ASR_ENGINE_MODEL_TYPE=16k_zh_en

# =========================
# AuK Studio Web 配置
# =========================

AUK_BASE_CKPT=./ckpts/AuK/auk_base.safetensors
AUK_BASE_CONFIG=./ckpts/AuK/config.yaml

AUK_FLASH_CKPT=./ckpts/AuK-Flash/auk_flash.safetensors
AUK_FLASH_CONFIG=./ckpts/AuK-Flash/config.yaml

# Everything below is optional; uncomment to override the built-in default.
# VRAM strategy: 0 = paged (encoder streams in per pass, fits an 8GB card),
# 1 = resident (encoder stays on the GPU, faster but needs well over 8GB).
# The page's Model and settings -> VRAM strategy picks this per load and wins over the env.
# AUK_RESIDENT=0

# Listen address/port. Keep 127.0.0.1: the workbench has no auth and can delete files.
# AUK_HOST=127.0.0.1
# AUK_PORT=8080

# Wall-clock cap in seconds for a load/generation; 0 = unlimited (a hung request is
# aborted with the page's "cancel" button). Only set this if you want a hard timeout.
# AUK_MODEL_TIMEOUT=0

# Log directory and level (launcher.log / server.log / worker.log).
# AUK_LOG_DIR=./logs
# AUK_LOG_LEVEL=INFO
